<% content_for :title, "Nouveau mot de passe" %><section class="auth-card"><h1>Votre nouveau <em>mot de passe.</em></h1><%= form_with url: password_path(params[:token]), method: :put do |form| %><%= form.label :password, "Nouveau mot de passe (12 caractères minimum)" %><%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password" %><%= form.label :password_confirmation, "Confirmer le mot de passe" %><%= form.password_field :password_confirmation, required: true, minlength: 12, autocomplete: "new-password" %><%= form.submit "Enregistrer", class: "button button-wide" %><% end %></section>
