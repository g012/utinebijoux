<% content_for :title, "Mot de passe oublié" %><section class="auth-card"><h1>Un nouveau <em>départ.</em></h1><p>Recevez un lien pour réinitialiser votre mot de passe.</p><%= form_with url: passwords_path do |form| %><%= form.label :email_address, "Adresse e-mail" %><%= form.email_field :email_address, required: true, autocomplete: "username" %><%= form.submit "Recevoir le lien", class: "button button-wide" %><% end %></section>
