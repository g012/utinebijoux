<% content_for :title, "Connexion à l’atelier" %><section class="auth-card"><div class="eyebrow">L’ESPACE DE LA CRÉATRICE</div><h1>Bonjour, <em>vous.</em></h1><p>Connectez-vous pour retrouver votre atelier.</p><%= form_with url: session_path do |form| %><%= form.label :email_address, "Adresse e-mail" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %><%= form.label :password, "Mot de passe" %><%= form.password_field :password, required: true, autocomplete: "current-password" %><%= form.submit "Entrer dans l’atelier", class: "button button-wide" %><% end %><%= link_to "Mot de passe oublié ?", new_password_path, class: "text-link" %></section>
