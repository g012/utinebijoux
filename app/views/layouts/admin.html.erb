<!DOCTYPE html><html lang="fr"><head><title>Administration · <%= Shop.name %></title><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag :app, "data-turbo-track": "reload" %><%= javascript_importmap_tags %></head><body class="admin-body"><header class="admin-header"><%= link_to Shop.name, admin_root_path, class: "brand" %><nav><%= link_to "Tableau de bord", admin_root_path %><%= link_to "Créations", admin_products_path %><%= link_to "Commandes", admin_orders_path %><%= link_to "Voir la boutique ↗", root_path %><%= button_to "Déconnexion", session_path, method: :delete, class: "text-button" %></nav></header><main class="admin-main"><% flash.each do |type, message| %><div class="flash <%= type %>" role="status"><%= message %></div><% end %><%= yield %></main></body></html>
