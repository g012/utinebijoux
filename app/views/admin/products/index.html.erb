<div class="admin-title"><h1>Les créations</h1><%= link_to "+ Nouvelle création", new_admin_product_path, class: "button" %></div><div class="table-scroll"><table class="admin-table"><thead><tr><th>Création</th><th>Prix</th><th>Stock disponible</th><th>État</th><th>Actions</th></tr></thead><tbody><% @products.each do |product| %><tr><td><div class="admin-product-name"><%= product_photo(product) %><div><strong><%= product.name %></strong><small><%= product.category %> · <%= product.stock_label %></small></div></div></td><td><%= money(product.price_cents) %></td><td><%= product.stock_quantity %></td><td><%= product.archived? ? "Archivée" : product.active? ? "Publiée" : "Brouillon" %></td><td><%= link_to "Modifier", edit_admin_product_path(product), class: "text-link" %></td></tr><% end %></tbody></table></div>

<%= render "shared/pagination" %>
