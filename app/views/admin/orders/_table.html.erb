<% if orders.any? %><div class="table-scroll"><table class="admin-table"><thead><tr><th>Commande</th><th>Date</th><th>Client</th><th>Total</th><th>Statut</th></tr></thead><tbody><% orders.each do |order| %><tr><td><%= link_to order.number, admin_order_path(order), class: "text-link" %></td><td><%= l(order.created_at, format: :short) %></td><td><%= order.customer_email.presence || "Paiement non finalisé" %></td><td><%= money(order.total_cents) %></td><td><span class="inline-badge"><%= order.status_label %></span></td></tr><% end %></tbody></table></div><% else %><p class="empty-message">La première commande ouvrira une jolie histoire.</p><% end %>
