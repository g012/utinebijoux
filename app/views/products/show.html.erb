<% content_for :title, @product.name %><% content_for :description, @product.description.truncate(160) %><% content_for :product_meta, "true" %><% content_for :og_image, url_for(@product.ordered_photos.first) if @product.photos.attached? %><% content_for :head do %><%= product_json_ld(@product) %><% end %>
<div class="wrap"><nav class="breadcrumb" aria-label="Fil d’Ariane"><%= link_to "La boutique", products_path %><span>/</span><%= link_to @product.category, products_path(category: @product.category) %><span>/</span><span><%= @product.name %></span></nav>
<section class="product-detail"><div class="product-gallery" data-controller="gallery"><div class="detail-main-photo"><% if @product.photos.attached? %><%= image_tag @product.ordered_photos.first, alt: @product.name, "data-gallery-target": "main", width: 1000, height: 1200 %><% else %><%= product_photo(@product) %><% end %></div><% if @product.photos.size > 1 %><div class="photo-thumbnails"><% @product.ordered_photos.each_with_index do |photo, index| %><button type="button" data-action="gallery#select" data-url="<%= url_for(photo) %>" aria-label="Voir la photo <%= index + 1 %> de <%= @product.name %>"><%= image_tag photo, alt: "#{@product.name}, vue #{index + 1}", loading: "lazy" %></button><% end %></div><% end %></div>
<div class="product-description"><div class="eyebrow"><%= @product.category %> · FAIT MAIN</div><h1><%= @product.name %></h1><div class="detail-price"><%= money(@product.price_cents) %><span class="inline-badge"><%= @product.stock_label %></span></div><div class="description-text"><%= simple_format @product.description %></div>
<% if @product.purchasable? %><%= form_with url: cart_items_path, class: "add-to-cart" do |form| %><%= form.hidden_field :product_id, value: @product.id %><% if @product.stock_quantity > 1 && !@product.unique_piece? %><%= form.label :quantity, "Quantité" %><%= form.number_field :quantity, value: 1, min: 1, max: [@product.stock_quantity, 99].min %><% else %><%= form.hidden_field :quantity, value: 1 %><% end %><%= form.button class: "button button-wide" do %>Adopter cette création <%= icon(:bag, size: 20) %><% end %><% end %><p class="stock-note"><span class="stock-dot"></span><%= @product.unique_piece? ? "Un seul exemplaire, rien que pour vous." : "#{@product.stock_quantity} exemplaire(s) disponible(s)." %></p><% else %><div class="sold-message"><%= icon(:heart) %><div><strong>Cette création a déjà trouvé sa personne.</strong><p>D’autres petits coups de cœur vous attendent à l’atelier.</p></div></div><%= link_to "Découvrir les autres créations", products_path, class: "button button-outline button-wide" %><% end %>
<div class="product-promises"><p><%= icon(:truck, size: 20) %> Livraison en France · <%= money(Shop.shipping_cents) %></p><p><%= icon(:heart, size: 20) %> Préparé et emballé avec soin</p><p><%= icon(:check, size: 20) %> Paiement sécurisé par Stripe</p></div><details class="care-details"><summary>Prendre soin de votre bijou</summary><p>Pour garder son éclat, évitez l’eau, le parfum et les produits ménagers. Rangez-le au sec et nettoyez-le délicatement avec un chiffon doux. Tenir hors de portée des jeunes enfants.</p></details></div></section>
<% if @related.any? %><section class="section"><div class="section-heading"><h2>Dans le même <em>esprit</em></h2></div><div class="product-grid related-grid"><%= render partial: "card", collection: @related, as: :product %></div></section><% end %></div>
