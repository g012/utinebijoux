<% content_for :title, "La boutique — bijoux faits main" %>
<div class="wrap page-top"><div class="eyebrow">DES PETITS BONHEURS À PORTER</div><h1>La <em>boutique.</em></h1><p>Des pièces choisies avec le cœur, à adopter pour longtemps.</p></div>
<section class="wrap shop-section"><div class="shop-toolbar"><nav class="filters" aria-label="Catégories"><%= link_to "Tout voir", products_path, class: params[:category].blank? ? "selected" : nil %><% Product::CATEGORIES.each do |category| %><%= link_to category == "Boucles" ? "Boucles d’oreilles" : category, products_path(category: category), class: params[:category] == category ? "selected" : nil %><% end %></nav><span class="results-count"><%= @total_count %> création<%= 's' if @total_count != 1 %></span></div>
<%= form_with url: products_path, method: :get, class: "shop-search" do |form| %><%= form.hidden_field :category, value: params[:category] if params[:category].present? %><%= form.search_field :q, placeholder: "Une couleur, une envie…", value: params[:q], "aria-label": "Rechercher une création" %><label class="checkbox-label"><%= form.check_box :available, { checked: params[:available] == "1" }, "1", "0" %> Disponibles uniquement</label><%= form.submit "Rechercher", class: "button button-small button-outline" %><% end %>
<div class="product-grid"><%= render partial: "card", collection: @products, as: :product %></div><% if @products.empty? %><div class="empty-state"><%= icon(:star, size: 36) %><h2>De nouvelles merveilles se préparent.</h2><p>Aucune création ne correspond à cette recherche.</p><%= link_to "Voir toutes les créations", products_path, class: "text-link" %></div><% end %></section>

<%= render "shared/pagination" %>
