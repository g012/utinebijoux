<% content_for :title, params[:collection] == "Les fruits" ? "La collection les fruits" : "La boutique — bijoux faits main" %>
<div class="wrap page-top">
  <div class="eyebrow">DES PETITS BONHEURS À PORTER</div>
  <h1><% if params[:collection] == "Les fruits" %>Les <em>fruits.</em><% else %>La <em>boutique.</em><% end %></h1>
  <p>Des pièces choisies avec le cœur, à adopter pour longtemps.</p>
</div>
<section class="wrap shop-section">
  <div class="shop-toolbar">
    <nav class="filters" aria-label="Catégories">
      <%= link_to "Tout voir", products_path(collection: params[:collection].presence), class: params[:category].blank? ? "selected" : nil %>
      <% Product::CATEGORIES.each do |category| %>
        <%= link_to category, products_path(category: category, collection: params[:collection].presence), class: params[:category] == category ? "selected" : nil %>
      <% end %>
    </nav>
    <span class="results-count"><%= @total_count %> création<%= 's' if @total_count != 1 %></span>
  </div>
  <% if @collections.any? %>
  <nav class="collection-filters" aria-label="Collections">
    <span>Collections</span>
    <%= link_to "Toutes", products_path(category: params[:category].presence), class: params[:collection].blank? ? "selected" : nil %>
    <% @collections.each do |collection| %>
      <%= link_to collection, products_path(category: params[:category].presence, collection: collection), class: params[:collection] == collection ? "selected" : nil %>
    <% end %>
  </nav>
  <% end %>
  <%= form_with url: products_path, method: :get, class: "shop-search" do |form| %>
    <%= form.hidden_field :category, value: params[:category] if params[:category].present? %>
    <%= form.hidden_field :collection, value: params[:collection] if params[:collection].present? %>
    <%= form.search_field :q, placeholder: "Une couleur, une envie…", value: params[:q], "aria-label": "Rechercher une création" %>
    <label class="checkbox-label"><%= form.check_box :available, { checked: params[:available] == "1" }, "1", "0" %> Disponibles uniquement</label>
    <%= form.submit "Rechercher", class: "button button-small button-outline" %>
  <% end %>
  <div class="product-grid"><%= render partial: "card", collection: @products, as: :product %></div>
  <% if @products.empty? %>
    <div class="empty-state">
      <%= icon(:star, size: 36) %>
      <% if @collection && !@collections.include?(@collection) %>
        <h2>Cette collection est en préparation.</h2>
        <p>Les créations de la collection « <%= @collection %> » seront bientôt à découvrir ici.</p>
      <% else %>
        <h2>De nouvelles merveilles se préparent.</h2>
        <p>Aucune création ne correspond à cette recherche.</p>
      <% end %>
      <%= link_to "Voir toutes les créations", products_path, class: "text-link" %>
    </div>
  <% end %>
  <%= render "shared/pagination" %>
</section>
