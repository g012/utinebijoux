<% content_for :title, "Commande #{@order.number}" %><% content_for :head do %><meta name="robots" content="noindex,nofollow"><% end %><section class="wrap order-confirmation"><div class="confirmation-icon"><%= icon(@order.paid? ? :check : :heart, size: 34) %></div><div class="eyebrow">COMMANDE <%= @order.number %></div><h1><% if @order.paid? %>Une jolie histoire <em>commence.</em><% elsif @order.pending_payment? %>Encore un <em>petit instant.</em><% else %>Une prochaine <em>fois, peut-être.</em><% end %></h1><p><% if @order.paid? %>Merci pour votre commande ! Nous préparons vos créations avec soin.<br>Un e-mail de confirmation vous sera envoyé.<% elsif @order.pending_payment? %>Nous attendons la confirmation du paiement par Stripe.<br>Vous pouvez actualiser cette page dans quelques instants.<% else %>Cette commande est <%= @order.status_label.downcase %>. Les créations non payées ont été remises en boutique.<% end %></p><div class="order-receipt"><span class="inline-badge"><%= @order.status_label %></span><% @order.order_items.each do |item| %><div class="receipt-line"><span><%= item.quantity %> × <%= item.display_name %></span><span><%= money(item.total_cents) %></span></div><% end %><div class="receipt-line"><span>Livraison en France</span><span><%= money(@order.shipping_cents) %></span></div><div class="receipt-line receipt-total"><strong>Total</strong><strong><%= money(@order.total_cents) %></strong></div></div><% if @order.pending_payment? %><%= link_to "Actualiser le statut", order_path(@order), class: "button" %><% else %><%= link_to "Retour à la boutique", products_path, class: "button button-outline" %><% end %></section>
