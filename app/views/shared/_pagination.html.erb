<% if @total_pages && @total_pages > 1 %>
  <nav class="pagination" aria-label="Pagination">
    <% if @page > 1 %><%= link_to "← Précédent", url_for(params.permit(:category, :collection, :q, :available).to_h.merge(page: @page - 1)), class: "text-link" %><% end %>
    <span>Page <%= @page %> sur <%= @total_pages %></span>
    <% if @page < @total_pages %><%= link_to "Suivant →", url_for(params.permit(:category, :collection, :q, :available).to_h.merge(page: @page + 1)), class: "text-link" %><% end %>
  </nav>
<% end %>
