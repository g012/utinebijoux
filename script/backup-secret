#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-}" in
  postgres)
    ssh -o BatchMode=yes -o ConnectTimeout=10 userve \
      "sed -n 's/^POSTGRES_PASSWORD=//p' /home/g012/apps/titine/secrets/postgres.env"
    ;;
  s3.access_key_id|s3.secret_access_key)
    mise exec -- bin/rails credentials:fetch "$1"
    ;;
  *) printf 'Unknown backup secret.\n' >&2; exit 1 ;;
esac
