#!/usr/bin/env bash
# Prints one deployment secret for .kamal/secrets; never commit or log the output.
set -euo pipefail
cd "$(dirname "$0")/.."
SECRETS_DIR=/home/g012/apps/titine/secrets
remote_value() {
  ssh -o BatchMode=yes -o ConnectTimeout=10 "${USERVE_HOST:-userve}" \
    "sed -n 's/^$2=//p' '$SECRETS_DIR/$1'"
}
case "${1:-}" in
  DATABASE_URL|SECRET_KEY_BASE|STRIPE_SECRET_KEY|STRIPE_WEBHOOK_SECRET|SMTP_USERNAME|SMTP_PASSWORD)
    remote_value production.env "$1"
    ;;
  POSTGRES_PASSWORD)
    remote_value postgres.env POSTGRES_PASSWORD
    ;;
  s3.access_key_id|s3.secret_access_key)
    mise exec -- ruby bin/rails credentials:fetch "$1"
    ;;
  *) printf 'Unknown deployment secret.\n' >&2; exit 1 ;;
esac
