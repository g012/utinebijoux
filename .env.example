# bin/dev (Foreman) reads .env. Export variables before standalone Rails commands.
APP_URL=http://localhost:3000
SHOP_NAME="les bijoux de titine"
SHOP_EMAIL=lesbijouxdetitine@gmail.com
ADMIN_EMAIL=lesbijouxdetitine@gmail.com
FRANCE_SHIPPING_CENTS=200
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Not needed: publishable key; hosted Checkout only uses the server secret key.
# Optional local PostgreSQL connection. Defaults to OS user / local socket.
# DATABASE_URL=postgresql://localhost/bijoux_development
# ADMIN_PASSWORD is only needed for `bin/rails admin:create`. Do not retain it.
# Production-only settings:
# RAILS_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/bijoux_production
# SECRET_KEY_BASE=generate_with_bin_rails_secret
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# JOB_CONCURRENCY=1
# RAILS_MAX_THREADS=5
